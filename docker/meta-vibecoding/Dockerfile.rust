# ABOUTME: Pre-built Docker base image for Rust meta-vibecoding cells.
# Includes Rust stable, cargo, Git, and common tools (clippy, rustfmt).

FROM rust:slim

LABEL org.opencontainers.image.title="meta-vibecoding/cell-rust"
LABEL org.opencontainers.image.description="Rust cell base image for meta-vibecoding platform"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Rust components (clippy and rustfmt come with the toolchain)
RUN rustup component add clippy rustfmt

# Create workspace directory
RUN mkdir -p /workspace
WORKDIR /workspace

# Placeholder for choraforge CLI (copied in at build time when available)
# COPY choraforge /usr/local/bin/choraforge

ENTRYPOINT ["/bin/bash"]
